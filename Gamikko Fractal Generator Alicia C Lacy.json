    <script>
        // JavaScript for interactive elements
        document.addEventListener('DOMContentLoaded', function() {
            // Civilization tabs functionality
            const tabButtons = document.querySelectorAll('.tab-btn');
            const civilizationCards = document.querySelectorAll('.civilization-card');
            
            tabButtons.forEach(button => {
                button.addEventListener('click', () => {
                    // Remove active class from all buttons
                    tabButtons.forEach(btn => btn.classList.remove('active'));
                    
                    // Add active class to clicked button
                    button.classList.add('active');
                    
                    // Get the civilization type
                    const civilization = button.getAttribute('data-civilization');
                    
                    // Simulate content change (in a real app, this would fetch new data)
                    civilizationCards.forEach((card, index) => {
                        setTimeout(() => {
                            card.style.opacity = '0.7';
                            setTimeout(() => {
                                // Change content based on selected civilization
                                const img = card.querySelector('.civilization-img i');
                                const title = card.querySelector('h3');
                                const desc = card.querySelector('p');
                                const progress = card.querySelector('.progress');
                                const completionText = card.querySelector('small');
                                
                                switch(civilization) {
                                    case 'egypt':
                                        if (index === 0) {
                                            img.className = 'fas fa-monument';
                                            title.textContent = 'Ancient Egypt';
                                            desc.textContent = 'Discover the mysteries of the pharaohs, pyramids, and the Nile River civilization.';
                                            progress.style.width = '75%';
                                            completionText.textContent = '75% of students completed this module';
                                        } else if (index === 1) {
                                            img.className = 'fas fa-sphinx';
                                            title.textContent = 'Egyptian Mythology';
                                            desc.textContent = 'Explore the gods, goddesses, and religious beliefs of ancient Egypt.';
                                            progress.style.width = '60%';
                                            completionText.textContent = '60% of students completed this module';
                                        } else {
                                            img.className = 'fas fa-scroll';
                                            title.textContent = 'Hieroglyphics';
                                            desc.textContent = 'Learn to read and write ancient Egyptian hieroglyphic script.';
                                            progress.style.width = '40%';
                                            completionText.textContent = '40% of students completed this module';
                                        }
                                        break;
                                    case 'greece':
                                        if (index === 0) {
                                            img.className = 'fas fa-columns';
                                            title.textContent = 'Ancient Greece';
                                            desc.textContent = 'Explore the birthplace of democracy, philosophy, and classical architecture.';
                                            progress.style.width = '65%';
                                            completionText.textContent = '65% of students completed this module';
                                        } else if (index === 1) {
                                            img.className = 'fas fa-helmet-battle';
                                            title.textContent = 'Greek Mythology';
                                            desc.textContent = 'Discover the stories of Zeus, Athena, and the Olympian gods.';
                                            progress.style.width = '50%';
                                            completionText.textContent = '50% of students completed this module';
                                        } else {
                                            img.className = 'fas fa-medal';
                                            title.textContent = 'Olympic Games';
                                            desc.textContent = 'Learn about the ancient Olympic Games and their significance.';
                                            progress.style.width = '55%';
                                            completionText.textContent = '55% of students completed this module';
                                        }
                                        break;
                                    case 'rome':
                                        if (index === 0) {
                                            img.className = 'fas fa-archway';
                                            title.textContent = 'Ancient Rome';
                                            desc.textContent = 'Learn about the Roman Empire, its engineering marvels, and legal systems.';
                                            progress.style.width = '45%';
                                            completionText.textContent = '45% of students completed this module';
                                        } else if (index === 1) {
                                            img.className = 'fas fa-shield-alt';
                                            title.textContent = 'Roman Army';
                                            desc.textContent = 'Discover the organization and tactics of the legendary Roman legions.';
                                            progress.style.width = '30%';
                                            completionText.textContent = '30% of students completed this module';
                                        } else {
                                            img.className = 'fas fa-gem';
                                            title.textContent = 'Roman Society';
                                            desc.textContent = 'Explore the daily life and social structure of ancient Rome.';
                                            progress.style.width = '35%';
                                            completionText.textContent = '35% of students completed this module';
                                        }
                                        break;
                                    case 'mesopotamia':
                                        if (index === 0) {
                                            img.className = 'fas fa-city';
                                            title.textContent = 'Mesopotamia';
                                            desc.textContent = 'Discover the cradle of civilization between the Tigris and Euphrates rivers.';
                                            progress.style.width = '40%';
                                            completionText.textContent = '40% of students completed this module';
                                        } else if (index === 1) {
                                            img.className = 'fas fa-scroll';
                                            title.textContent = 'Cuneiform Writing';
                                            desc.textContent = 'Learn about one of the earliest systems of writing invented by the Sumerians.';
                                            progress.style.width = '35%';
                                            completionText.textContent = '35% of students completed this module';
                                        } else {
                                            img.className = 'fas fa-code';
                                            title.textContent = 'Legal Codes';
                                            desc.textContent = 'Explore the Code of Hammurabi and other early legal systems.';
                                            progress.style.width = '25%';
                                            completionText.textContent = '25% of students completed this module';
                                        }
                                        break;
                                }
                                
                                card.style.opacity = '1';
                            }, 300);
                        }, index * 100);
                    });
                });
            });
            
            // Animate progress bars on scroll
            const progressBars = document.querySelectorAll('.progress');
            
            function animateProgressBars() {
                progressBars.forEach(bar => {
                    const width = bar.style.width;
                    bar.style.width = '0';
                    
                    setTimeout(() => {
                        bar.style.transition = 'width 1.5s ease-in-out';
                        bar.style.width = width;
                    }, 200);
                });
            }
            
            // Run on initial load
            setTimeout(animateProgressBars, 1000);
            
            // Contact form submission
            const contactForm = document.getElementById('contactForm');
            if (contactForm) {
                contactForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    
                    // Get form values
                    const name = document.getElementById('name').value;
                    const email = document.getElementById('email').value;
                    const subject = document.getElementById('subject').value;
                    const message = document.getElementById('message').value;
                    
                    // In a real application, you would send this data to a server
                    // For this example, we'll just show an alert
                    alert(`Thank you for your message, ${name}! We will contact you at ${email} soon.`);
                    
                    // Reset form
                    contactForm.reset();
                });
            }
            
            // Smooth scrolling for navigation links
            document.querySelectorAll('nav a').forEach(anchor => {
                anchor.addEventListener('click', function(e) {
                    e.preventDefault();
                    
                    const targetId = this.getAttribute('href');
                    if (targetId.startsWith('#')) {
                        const targetElement = document.querySelector(targetId);
                        if (targetElement) {
                            window.scrollTo({
                                top: targetElement.offsetTop - 80,
                                behavior: 'smooth'
                            });
                        }
                    }
                });
            });
        });
    </script>
